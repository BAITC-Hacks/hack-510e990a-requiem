{
  "name": "eventmatch-hackalem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Объяснимый подбор event-подрядчиков для HackAlem",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
